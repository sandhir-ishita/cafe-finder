
# ─── Frontend Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it is in .gitignore.

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:5000

# Google Maps JavaScript API key (used for the map embed in the browser)
# Restrict this key to your domain(s) in Google Cloud Console under
# Application restrictions → HTTP referrers.
# This key is intentionally browser-facing (map embed only).
# Server-side Places/Directions calls use the backend key, NOT this one.
VITE_GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_BROWSER_MAPS_KEY
