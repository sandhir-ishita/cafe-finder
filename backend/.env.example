
# ─── Backend Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it is in .gitignore.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JWT secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Rotate immediately if exposed.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Server port
PORT=5000

# Google Maps / Places API key (restrict to your server IP in Google Cloud Console)
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_KEY

# OpenAI API key
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_KEY

# OpenAI model to use for recommendations and chat
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed frontend origins (no trailing slash)
# e.g. for prod + staging: https://mycafe.com,https://staging.mycafe.com
FRONTEND_URL=http://localhost:5173

# Node environment: development | production | test
NODE_ENV=development
